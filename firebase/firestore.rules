rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }
    function isRole(role) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    function isAdmin() { return isRole('admin'); }
    function isRider() { return isRole('rider'); }
    function isCustomer() { return isRole('customer'); }
    function isApprovedRider() {
      return isRider() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.riderApprovalStatus == 'approved';
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // ── Users collection ──────────────────────────────────────────────
    match /users/{userId} {
      // Users can read their own document
      // Admins can read and write all user documents
      // Riders can read their own document
      allow read: if isOwner(userId) || isAdmin() ||
                     (isRider() && resource.data.role == 'rider');
      // Only admins can create/activate/deactivate users (except self-registration via Cloud Functions)
      allow create: if isAdmin() || isOwner(userId);
      allow update: if isAdmin() ||
                       (isOwner(userId) &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['name', 'phone', 'address', 'mfa']));
      allow delete: if isAdmin();

      // ── MFA sub-collection (secrets, recovery codes) ──────────────
      match /mfa/{mfaId} {
        // Only the user themselves can read their MFA data
        // In production, MFA secrets are stored in Firebase Auth, not Firestore
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // ── Rider documents metadata ──────────────────────────────────────
    match /rider_documents/{docId} {
      // Only the rider who owns the document and admins can read
      // Customers NEVER have access to rider verification documents
      allow read: if isOwner(resource.data.riderId) || isAdmin();
      // Only the rider or admin can create
      allow create: if isOwner(request.resource.data.riderId) || isAdmin();
      allow update, delete: if isOwner(resource.data.riderId) || isAdmin();
    }

    // ── Audit log ─────────────────────────────────────────────────────
    match /audit_log/{entryId} {
      // Only admins can read the full audit log
      // Riders can read entries about themselves
      allow read: if isAdmin() ||
                     (isRider() && resource.data.riderId == request.auth.uid);
      // Only Cloud Functions (admin SDK) can write audit entries
      allow write: if false;
    }

    // ── Restaurants ───────────────────────────────────────────────────
    match /restaurants/{restaurantId} {
      allow read: if true; // Public listing
      allow create, update, delete: if isAdmin();
    }

    // ── Food items ────────────────────────────────────────────────────
    match /food_items/{foodId} {
      allow read: if true; // Public menu
      allow create, update, delete: if isAdmin();
    }

    // ── Orders ────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Customers can read their own orders
      // Riders can read orders assigned to them or available orders
      // Admins can read all orders
      allow read: if isAdmin() ||
                     (isCustomer() && resource.data.customerId == request.auth.uid) ||
                     (isRider() && (resource.data.riderId == request.auth.uid ||
                                    resource.data.riderId == null));

      // Customers create their own orders (pricing calculated on backend)
      allow create: if isCustomer() &&
                       request.resource.data.customerId == request.auth.uid;

      // Customers can update their own draft/placed orders
      // Riders can update delivery status on their assigned orders
      // Admins can update any order
      allow update: if isAdmin() ||
                       (isCustomer() &&
                        resource.data.customerId == request.auth.uid &&
                        resource.data.status in ['draft', 'placed', 'updated'] &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['lines', 'address', 'status', 'revision', 'deliveryPoint', 'financials'])) ||
                       (isApprovedRider() &&
                        resource.data.riderId == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'revision']));

      // Only admins can delete orders
      allow delete: if isAdmin();

      // ── Rider location updates sub-collection ────────────────────
      match /rider_locations/{locationId} {
        // Only the assigned rider can write their location
        allow create: if isApprovedRider() &&
                         get(/databases/$(database)/documents/orders/$(orderId)).data.riderId == request.auth.uid;
        // Customer who owns the order can read rider locations
        // Admins can read all locations
        allow read: if isAdmin() ||
                     (isCustomer() &&
                      get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid &&
                      get(/databases/$(database)/documents/orders/$(orderId)).data.status == 'pickedUp');
        allow update, delete: if isAdmin();
      }
    }

    // ── Carts (customer-owned, one per customer) ──────────────────────
    // Cart lives in Firestore so it syncs across devices and survives reinstalls.
    // Only the authenticated customer who owns the cart can read or write it.
    match /carts/{cartId} {
      // cartId equals the customer's uid (one cart per customer)
      allow read: if isCustomer() && isOwner(cartId);
      allow create: if isCustomer() &&
                       request.resource.data.customerId == request.auth.uid;
      allow update: if isCustomer() &&
                       resource.data.customerId == request.auth.uid &&
                       request.resource.data.customerId == request.auth.uid;
      allow delete: if isCustomer() && isOwner(cartId);

      // ── Cart items sub-collection ──────────────────────────────────
      match /cart_items/{itemId} {
        allow read: if isCustomer() && isOwner(cartId);
        allow create: if isCustomer() &&
                       request.resource.data.customerId == request.auth.uid &&
                       // Verify food item exists and is available
                       get(/databases/$(database)/documents/food_items/$(request.resource.data.foodId)).data.available == true &&
                       // Verify restaurant is active
                       get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)).data.active == true;
        allow update: if isCustomer() &&
                       resource.data.customerId == request.auth.uid &&
                       // Only quantity can change, price snapshot stays
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity']);
        allow delete: if isCustomer() && isOwner(cartId);
      }
    }

    // ── Delivery addresses (customer-owned) ───────────────────────────
    match /addresses/{addressId} {
      allow read: if isCustomer() && resource.data.customerId == request.auth.uid;
      allow create: if isCustomer() &&
                       request.resource.data.customerId == request.auth.uid;
      allow update: if isCustomer() &&
                       resource.data.customerId == request.auth.uid;
      allow delete: if isCustomer() && resource.data.customerId == request.auth.uid;
    }

    // ── Reviews ───────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true; // Public reviews
      allow create: if isCustomer() &&
                       get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.auth.uid;
      allow update, delete: if isCustomer() &&
                               resource.data.customerId == request.auth.uid;
    }

    // ── App configuration ─────────────────────────────────────────────
    match /config/{configId} {
      // Delivery pricing and commission config readable by all signed-in users
      allow read: if isSignedIn();
      // Only admins can change configuration
      allow write: if isAdmin();
    }

    // ── Rider applications ────────────────────────────────────────────
    match /rider_applications/{applicationId} {
      // Rider can read their own application
      // Admin can read all applications
      allow read: if isOwner(applicationId) || isAdmin();
      // Rider creates and updates their own application
      allow create: if isOwner(request.resource.data.riderId);
      allow update: if isOwner(resource.data.riderId) || isAdmin();
      // Approval/rejection status changes are done via Cloud Functions (admin SDK)
      // to prevent riders from approving themselves
      // The riderApprovalStatus field can only be changed by admin
    }
  }
}
